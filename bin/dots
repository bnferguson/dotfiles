#!/usr/bin/env bash
# Routine maintenance is unattended; bootstrap remains the first-install path.

set -o pipefail
parentDirectory="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
dotfilesDirectory="$(cd "$(dirname "$parentDirectory")" && pwd -P)"
interactive=0
verbose=0
for option in "$@"; do
	case "$option" in
		-h|--help)
			echo "Usage: dots [-e|--edit] [--interactive] [--verbose] [--log-path]"
			echo "Default: unattended updates with a persistent log."
			echo "--interactive: allow prompts and machine setup."
			echo "--verbose: show full command output in the terminal."
			echo "--log-path: print the latest log path without running maintenance."
			exit 0 ;;
		-e|--edit) exec "${EDITOR:-vi}" "$dotfilesDirectory" ;;
		--interactive) interactive=1 ;;
		--verbose) verbose=1 ;;
		--log-path) echo "${DOTS_LOG_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/dots}/latest.log"; exit 0 ;;
		*) echo "Invalid option: $option" >&2; exit 2 ;;
	esac
done

# Capture both streams, without shell tracing or environment/credential dumps.
# The child exit status survives tee. Logs may contain third-party tool output:
# keep them private and outside the repository.
if [ "${DOTS_LOGGING:-0}" != 1 ]; then
	umask 077
	logDirectory="${DOTS_LOG_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/dots}"
	mkdir -p "$logDirectory" || exit 1
	logFile="$logDirectory/run-$(date +%Y%m%d-%H%M%S)-$$.log"
	: > "$logFile" || exit 1
	ln -sfn "$(basename "$logFile")" "$logDirectory/latest.log" || exit 1
	if [ -t 1 ] && [ "${TERM:-dumb}" != dumb ]; then
		# Keep the terminal separate from the log so colors never enter it.
		DOTS_LOGGING=1 DOTS_TERMINAL_LOG="$logFile" bash "$0" "$@" 3>&1 >>"$logFile" 2>&1
		exit $?
	fi
	echo "› Log: $logFile"
	DOTS_LOGGING=1 DOTS_TERMINAL_LOG= bash "$0" "$@" 2>&1 | tee "$logFile"
	statuses=("${PIPESTATUS[@]}")
	[ "${statuses[1]}" -eq 0 ] || exit 1
	exit "${statuses[0]}"
fi

export PATH="$HOME/.local/bin:${CARGO_HOME:-$HOME/.cargo}/bin:$PATH"
export ZSH="$dotfilesDirectory"
export DOTFILES_UPDATE=1
failedSteps=()
sudoShim=""
terminalLog="${DOTS_TERMINAL_LOG:-}"
started=$SECONDS
cyan="" green="" yellow="" red="" dim="" reset=""
if [ -n "$terminalLog" ]; then
	if [ -z "${NO_COLOR:-}" ]; then
		cyan=$'\e[1;36m' green=$'\e[1;32m' yellow=$'\e[1;33m'
		red=$'\e[1;31m' dim=$'\e[2m' reset=$'\e[0m'
	fi
	mode="unattended"
	[ "$interactive" -eq 0 ] || mode="interactive"
	printf '\n  %sdots%s  %s%s%s\n  %sLog  %s%s\n\n' \
		"$cyan" "$reset" "$dim" "$mode" "$reset" "$dim" "$terminalLog" "$reset" >&3
fi

elapsed() {
	local seconds=$1
	if [ "$seconds" -ge 60 ]; then
		printf '%dm %02ds' "$((seconds / 60))" "$((seconds % 60))"
	else
		printf '%ds' "$seconds"
	fi
}

display() {
	[ -n "$terminalLog" ] || return 0
	printf '  %s%s%s  %s\n' "$1" "$2" "$reset" "$3" >&3
}

notice() {
	printf '%s\n' "$1"
	case "$1" in
		'› SKIP: '*) display "$dim" '–' "${1#› SKIP: }" ;;
		*) display "$yellow" '!' "${1#! }" ;;
	esac
}

finish() {
	local status=$? label duration
	[ -z "$sudoShim" ] || rm -rf "$sudoShim"
	echo "› dots finished: exit=$status; failed steps=${#failedSteps[@]}; $(date -u +%FT%TZ)"
	[ -n "$terminalLog" ] || return
	printf '\n' >&3
	duration=$(elapsed "$((SECONDS - started))")
	if [ "$status" -eq 0 ]; then
		display "$green" '✓' "Maintenance complete  ·  $duration"
	else
		display "$red" '×' "Maintenance failed  ·  exit $status  ·  $duration"
		for label in "${failedSteps[@]}"; do
			display "$red" '·' "$label"
		done
		display "$dim" '↳' "Full log  $terminalLog"
	fi
}
trap finish EXIT

if [ "$interactive" -eq 0 ]; then
	export DOTFILES_UNATTENDED=1 NONINTERACTIVE=1 MISE_YES=1 GIT_TERMINAL_PROMPT=0
	export GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh} -oBatchMode=yes"
	# EOF handles ordinary confirmations. sudo can read /dev/tty even at EOF,
	# so give every child a wrapper that requires existing authorization.
	exec </dev/null
	realSudo="$(command -v sudo || true)"
	if [ -n "$realSudo" ]; then
		sudoShim="$(mktemp -d "${TMPDIR:-/tmp}/dots-sudo.XXXXXX")" || exit 1
		printf '#!/bin/sh\nexec "%s" -n "$@"\n' "$realSudo" > "$sudoShim/sudo"
		chmod 700 "$sudoShim/sudo"
		export PATH="$sudoShim:$PATH"
	fi
else
	export DOTFILES_UNATTENDED=0
fi

step() {
	local label=$1 start=$SECONDS firstLine status duration
	shift
	echo "› START: $*"
	display "$cyan" '→' "$label"
	if [ -n "$terminalLog" ] && { [ "$interactive" -eq 1 ] || [ "$verbose" -eq 1 ]; }; then
		"$@" 2>&1 | tee -a "$terminalLog" >&3
		local -a statuses=("${PIPESTATUS[@]}")
		status=${statuses[0]}
		[ "${statuses[1]}" -eq 0 ] || status=1
	else
		if [ -n "$terminalLog" ]; then
			firstLine=$(wc -l < "$terminalLog")
		fi
		"$@"
		status=$?
	fi
	duration=$(elapsed "$((SECONDS - start))")
	if [ "$status" -eq 0 ]; then
		display "$green" '✓' "$label  ·  $duration"
	else
		display "$red" '×' "$label  ·  exit $status  ·  $duration"
		if [ -n "$firstLine" ]; then
			tail -n "+$((firstLine + 1))" "$terminalLog" | tail -n 8 >&3
		fi
	fi
	echo "› END: $* (exit=$status)"
	return "$status"
}

# Installers run outside conditions so each keeps its own failure semantics.
run() {
	local label=$1 status
	shift
	step "$label" "$@"
	status=$?
	if [ "$status" -ne 0 ]; then
		failedSteps+=("$label")
		echo "! Failed: $*; continuing independent maintenance steps." >&2
	fi
}

if [ -n "$(git -C "$dotfilesDirectory" ls-files --unmerged)" ]; then
	notice "! Resolve the existing Git conflicts before running dots." >&2
	exit 1
fi
branch="$(git -C "$dotfilesDirectory" symbolic-ref --quiet --short HEAD || true)"
case "$branch" in
	main)
		# Preserve the existing best-effort pull policy: no stash or merge.
		if ! step "Update dotfiles" git -C "$dotfilesDirectory" pull --no-rebase --ff-only --no-autostash origin main; then
			notice "! Repository update failed; continuing maintenance with current dotfiles." >&2
		fi ;;
	*) notice "! Not on main; skipping repository update and continuing maintenance." >&2 ;;
esac
if [ -n "$(git -C "$dotfilesDirectory" ls-files --unmerged)" ]; then
	notice "! Repository has unresolved conflicts; skipping the rest of dots." >&2
	exit 1
fi
# The private overlay follows the same best-effort policy; script/install
# links whatever it now contains.
privateDirectory="${DOTFILES_PRIVATE:-$HOME/.dotfiles-private}"
if [ -d "$privateDirectory/.git" ]; then
	privateBranch="$(git -C "$privateDirectory" symbolic-ref --quiet --short HEAD || true)"
	if [ "$privateBranch" = main ]; then
		step "Update private overlay" git -C "$privateDirectory" pull --no-rebase --ff-only --no-autostash origin main ||
		notice "! Private overlay update failed; continuing with its current state." >&2
	else
		notice "! Private overlay not on main; skipping its update." >&2
	fi
fi

case "$(uname -s)" in
	Darwin)
		if [ "$interactive" -eq 1 ]; then
			for setup in setup-sudoers.sh set-defaults.sh set-hostname.sh; do
				[ ! -f "$ZSH/macos/scripts/$setup" ] || run "macOS setup · ${setup%.sh}" bash "$ZSH/macos/scripts/$setup"
			done
		else
			notice "› SKIP: macOS machine setup (use dots --interactive or script/bootstrap)."
		fi
		if command -v brew >/dev/null 2>&1; then
			run "Refresh Homebrew" brew update
			run "Upgrade Homebrew packages" brew upgrade
		fi ;;
	Linux)
		if command -v omarchy >/dev/null 2>&1; then
			if [ "$interactive" -eq 1 ]; then
				run "Update Omarchy" omarchy update
			else
				notice "› SKIP: interactive Omarchy system update (use dots --interactive)."
			fi
		fi ;;
esac

# Install prerequisites before attempting upgrades on a fresh machine.
run "Install packages and apply dotfiles" "$ZSH/script/install"
# Only upgrade the global mise toolchain, never the invoking project's pins.
if command -v mise >/dev/null 2>&1; then
	run "Upgrade mise tools" mise -C / upgrade --yes
fi
if [ -x "$ZSH/bin/pstack-sync" ]; then
	run "Check pstack" "$ZSH/bin/pstack-sync" check
fi
[ "${#failedSteps[@]}" -eq 0 ]
