#!/usr/bin/env bash
#
# dot
#
# `dot` handles installation, updates, things like that. Run it periodically
# to make sure you're on the latest and greatest.

set -e

parentDirectory="$(cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd -P)"
dotfilesDirectory="$(cd "$( dirname "$parentDirectory" )" && pwd -P)"

displayUsageAndExit() {
	echo "dot -- dotfiles management"
	echo ""
	echo "Usage: dot [options]"
	echo ""
	echo "Options:"
	echo "  -e, --edit    Open dotfiles directory for editing"
	echo "  -h, --help    Show this help message and exit"
	exit
}

while test $# -gt 0; do
	case "$1" in
		"-h"|"--help")
			displayUsageAndExit
			;;
		"-e"|"--edit")
			exec "$EDITOR" "$dotfilesDirectory"
			exit
			;;
		*)
			echo "Invalid option: $1"
			displayUsageAndExit
			;;
	esac
	shift
done

export ZSH=$HOME/.dotfiles

# Never run installers from an unresolved merge (including an old autostash).
if [ -n "$(git -C "$dotfilesDirectory" ls-files --unmerged)" ]; then
	echo "! Resolve the existing Git conflicts before running dots." >&2
	exit 1
fi

# Update before running installers, regardless of the caller's directory.
# Only update main; leave feature branches and detached worktrees untouched.
branch="$(git -C "$dotfilesDirectory" symbolic-ref --quiet --short HEAD || true)"
case "$branch" in
	main)
		# A fast-forward merge allows unrelated edits even with pull.rebase set.
		# Never stash: overlapping edits block the update without changing them.
		# Explicit flags also override configured merge/rebase autostashing.
		echo "› git pull --no-rebase --ff-only --no-autostash origin main"
		if ! git -C "$dotfilesDirectory" pull --no-rebase --ff-only --no-autostash origin main; then
			echo "! Repository update failed; continuing maintenance with current dotfiles." >&2
		fi
		;;
	*)
		echo "! Not on main; skipping repository update and continuing maintenance." >&2
		;;
esac

# Retain the safety check if an updater leaves unmerged files behind.
if [ -n "$(git -C "$dotfilesDirectory" ls-files --unmerged)" ]; then
	echo "! Repository has unresolved conflicts; skipping the rest of dots." >&2
	exit 1
fi

# macOS-specific updates
if [ "$(uname -s)" = "Darwin" ]; then
	# Ensure passwordless sudo for softwareupdate is in place (idempotent) so the
	# `sudo softwareupdate` in macos/scripts/install.sh doesn't prompt. Run it as a
	# subprocess — it `exit 0`s when the rule already exists, which would otherwise
	# abort the rest of this script when sourced.
	if [ -x "$ZSH/macos/scripts/setup-sudoers.sh" ]; then
		"$ZSH/macos/scripts/setup-sudoers.sh"
	fi

	if [ -f "$ZSH/macos/scripts/set-defaults.sh" ]; then
		"$ZSH/macos/scripts/set-defaults.sh"
	fi

	if [ -f "$ZSH/macos/scripts/set-hostname.sh" ]; then
		"$ZSH/macos/scripts/set-hostname.sh"
	fi

	if command -v brew >/dev/null 2>&1; then
		echo "› brew update"
		brew update
		echo "› brew upgrade"
		brew upgrade
	fi
fi

# Linux-specific updates
if [ "$(uname -s)" = "Linux" ]; then
	if command -v omarchy >/dev/null 2>&1; then
		echo "› omarchy update"
		omarchy update
	fi
fi

# Update mise-managed tools.
#
# `mise install` (run by mise/install.sh during script/install below) only
# fetches what's missing. A `latest` pin that already resolved to some version
# is a no-op for it, so without this the mise half of the toolchain silently
# freezes while the brew/pacman half keeps moving.
#
# Run from / so only the global config applies. `dots` can be invoked from any
# directory, and mise resolves configs from the working directory upward — so
# without this, running dots inside a project would upgrade that project's
# pinned tools too. `upgrade` has a --local flag but no --global inverse, and /
# is the one directory guaranteed never to hold a mise.toml. Don't "simplify"
# this to $ZSH: the dotfiles root is a plausible home for one.
if command -v mise >/dev/null 2>&1; then
	echo "› mise upgrade"
	mise -C / upgrade --yes
fi

# Run topic installers
echo "› $ZSH/script/install"
$ZSH/script/install
