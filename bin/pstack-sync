#!/usr/bin/env python3
"""Pin upstream pstack, render portable skills, and install managed links."""
import argparse
import fcntl
import hashlib
import io
import json
import os
from pathlib import Path, PurePosixPath
import re
import shutil
import subprocess
import tarfile
import tempfile
from urllib.parse import unquote


ROOT = Path(__file__).resolve().parents[1]
PREFIX = "pstack-"


def git(*args, cwd=None, binary=False):
    result = subprocess.run(["git", *args], cwd=cwd, check=True,
                            capture_output=True, text=not binary, timeout=60,
                            env={**os.environ, "GIT_TERMINAL_PROMPT": "0"})
    return result.stdout if binary else result.stdout.strip()


def files(directory):
    result = {}
    for path in sorted(directory.rglob("*")):
        if path.is_symlink():
            raise ValueError(f"Unexpected symlink in package: {path}")
        if path.is_file():
            result[path.relative_to(directory).as_posix()] = (
                path.read_bytes(), bool(path.stat().st_mode & 0o111))
    return result


def fingerprint(entries):
    digest = hashlib.sha256()
    for name, (data, executable) in sorted(entries.items()):
        digest.update(name.encode() + b"\0" + str(int(executable)).encode() + b"\0")
        digest.update(hashlib.sha256(data).digest())
    return digest.hexdigest()


def git_tree(entries):
    """Reproduce Git's tree ID without writing objects into the dotfiles repo."""
    def object_id(kind, data):
        return hashlib.sha1(kind.encode() + b" " + str(len(data)).encode() + b"\0" + data).digest()

    tree = {}
    for name, entry in entries.items():
        node = tree
        parts = name.split("/")
        for part in parts[:-1]:
            node = node.setdefault(part, {})
        node[parts[-1]] = entry

    def encode(node):
        data = b""
        for name, entry in sorted(node.items(), key=lambda item: item[0] + ("/" if isinstance(item[1], dict) else "")):
            if isinstance(entry, dict):
                mode, oid = b"40000", encode(entry)
            else:
                content, executable = entry
                mode, oid = b"100755" if executable else b"100644", object_id("blob", content)
            data += mode + b" " + name.encode() + b"\0" + oid
        return object_id("tree", data)
    return encode(tree).hex()


def skill_names(entries):
    names = sorted(path.split("/")[1] for path in entries
                   if re.fullmatch(r"skills/[^/]+/SKILL.md", path))
    if not names:
        raise ValueError("Upstream contains no skills")
    for name in names:
        if not re.fullmatch(r"[a-z0-9]+(?:-[a-z0-9]+)*", name) or len(PREFIX + name) > 64:
            raise ValueError(f"Unsupported skill name: {name}")
        text = entries[f"skills/{name}/SKILL.md"][0].decode()
        if not text.startswith("---\n") or "\n---\n" not in text[4:]:
            raise ValueError(f"Missing frontmatter: {name}")
        header = text.split("\n---\n", 1)[0]
        if not re.search(rf"^name:\s*[\"']?{re.escape(name)}[\"']?\s*$", header, re.M):
            raise ValueError(f"Skill name and directory disagree: {name}")
        if not re.search(r"^description:\s*\S", header, re.M):
            raise ValueError(f"Missing skill description: {name}")
    return names


def render(root, source):
    names = skill_names(source)
    result = {}
    name_pattern = "|".join(re.escape(name) for name in sorted(names, key=len, reverse=True))
    # Preserve the full package so scripts, images, and relative references survive.
    for path, (data, executable) in source.items():
        destination = re.sub(rf"^skills/({name_pattern})(?=/)", rf"skills/{PREFIX}\1", path)
        if path.endswith(".md"):
            text = data.decode()
            text = re.sub(rf"(?<=skills/)({name_pattern})(?=/)", rf"{PREFIX}\1", text)
            text = re.sub(rf"(?<=\.\./)({name_pattern})(?=/)", rf"{PREFIX}\1", text)

            def local_link(match):
                target = match[1]
                return "](" + os.path.relpath(target, str(PurePosixPath(destination).parent)) + ")"

            text = re.sub(r"\]\(https://github\.com/cursor/plugins/(?:blob|tree)/main/pstack/([^\s)]+)\)",
                          local_link, text)
            # Bare URLs remain links to upstream's original names.
            text = re.sub(r"(https://github\.com/cursor/plugins/(?:blob|tree)/main/pstack/skills/)pstack-",
                          r"\1", text)
            if re.fullmatch(r"skills/[^/]+/SKILL.md", path):
                header, body = text.split("\n---\n", 1)
                name = path.split("/")[1]
                header = re.sub(r"^name:.*$", f"name: {PREFIX}{name}", header, flags=re.M)
                note = ("Read [the cross-agent adapter](../../adapter.md) before following this skill. "
                        "It applies to this workflow and every bundled skill it invokes.\n")
                text = header + "\n---\n\n" + note + body
                # Preserve upstream's explicit-only choice in Codex's native policy.
                if re.search(r"^disable-model-invocation:\s*true\s*$", header, re.M):
                    policy_path = str(PurePosixPath(destination).parent / "agents/openai.yaml")
                    if str(PurePosixPath(path).parent / "agents/openai.yaml") in source:
                        raise ValueError(f"Upstream added UI metadata requiring adapter review: {policy_path}")
                    result[policy_path] = (b"policy:\n  allow_implicit_invocation: false\n", False)
            data = text.encode()
        result[destination] = (data, executable)
    result["adapter.md"] = ((root / "pstack/adapters/shared.md").read_bytes(), False)
    validate_links(result)
    return result


def validate_links(entries):
    # Existing upstream links can be broken. Reject new breakage from renaming.
    for path, (data, _) in entries.items():
        if not path.endswith(".md"):
            continue
        for href in re.findall(r"\]\(([^)\s]+)\)", data.decode()):
            target = unquote(re.split(r"[#?]", href)[0])
            if not target or re.match(r"[a-zA-Z][\w+.-]*:", target) or "<" in target or ">" in target:
                continue
            normalized = os.path.normpath(str(PurePosixPath(path).parent / target))
            if normalized in entries or any(name.startswith(normalized.rstrip("/") + "/") for name in entries):
                continue
            # The namespace transformation must not leave a stale skill path.
            if (("/pstack-" in target and normalized.startswith("skills/"))
                    or target.endswith("SKILL.md")):
                raise ValueError(f"Broken generated skill link: {path} -> {href}")


def read_lock(root):
    value = json.loads((root / "pstack/lock.json").read_text())
    if value.get("format") != 1 or value.get("path") != "pstack":
        raise ValueError("Unsupported pstack lock format")
    if not re.fullmatch(r"[0-9a-f]{40}", value["commit"]):
        raise ValueError("Invalid pinned commit")
    return value


def verified(root):
    lock = read_lock(root)
    source = files(root / "pstack/upstream")
    if git_tree(source) != lock["tree"]:
        raise ValueError("Pinned upstream snapshot changed; restore it or run pstack-sync update")
    generated = render(root, source)
    if fingerprint(generated) != lock["generated_sha256"]:
        raise ValueError("Adapter output changed; run pstack-sync update to record and validate it")
    return lock, generated


def write_tree(destination, entries):
    destination.mkdir(parents=True, exist_ok=True)
    for name, (data, executable) in entries.items():
        path = destination / name
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_bytes(data)
        path.chmod(0o755 if executable else 0o644)


def generated_matches(directory, entries):
    stamp = directory / ".pstack-output-sha256"
    if not stamp.is_file() or stamp.read_text() != fingerprint(entries):
        return False
    # Helpers install dependencies beside their scripts. Verify managed files
    # without traversing or discarding those runtime caches on every dots run.
    for name, (data, executable) in entries.items():
        path = directory / name
        if (path.is_symlink() or not path.is_file() or path.read_bytes() != data
                or bool(path.stat().st_mode & 0o111) != executable):
            return False
    return True


def link_plan(root, names):
    return {root / directory / (PREFIX + name): root / "pstack/generated/skills" / (PREFIX + name)
            for directory in (".agents/skills", "claude/config/skills") for name in names}


def preflight_links(plan):
    for path, target in plan.items():
        if path.is_symlink() and path.resolve() == target.resolve():
            continue
        if path.exists() or path.is_symlink():
            raise ValueError(f"Refusing to replace an unmanaged skill: {path}")


def install(root):
    lock, generated = verified(root)
    names = [path.split("/")[1][len(PREFIX):] for path in generated
             if re.fullmatch(r"skills/[^/]+/SKILL.md", path)]
    plan = link_plan(root, names)
    preflight_links(plan)
    destination = root / "pstack/generated"
    if destination.is_symlink():
        raise ValueError(f"Refusing generated directory symlink: {destination}")
    if not generated_matches(destination, generated):
        with tempfile.TemporaryDirectory(prefix=".pstack-", dir=root / ".cache") as temporary:
            staged = Path(temporary) / "generated"
            write_tree(staged, generated)
            (staged / ".pstack-output-sha256").write_text(fingerprint(generated))
            if destination.exists():
                destination.rename(Path(temporary) / "previous")
            staged.rename(destination)
    for path, target in plan.items():
        path.parent.mkdir(parents=True, exist_ok=True)
        if not path.is_symlink():
            path.symlink_to(os.path.relpath(target, path.parent))
    for directory in (root / ".agents/skills", root / "claude/config/skills"):
        for path in directory.glob(PREFIX + "*"):
            if path not in plan and path.is_symlink():
                target = Path(os.path.abspath(path.parent / os.readlink(path)))
                if target.parent == destination / "skills":
                    path.unlink()
    print(f"pstack: installed {len(names)} skills at {lock['commit'][:12]}")


def fetch(repository, branch, temporary):
    checkout = Path(temporary) / "git"
    git("init", str(checkout))
    git("remote", "add", "origin", repository, cwd=checkout)
    git("config", "remote.origin.promisor", "true", cwd=checkout)
    git("config", "remote.origin.partialclonefilter", "blob:none", cwd=checkout)
    git("fetch", "--depth=1", "--filter=blob:none", "origin", branch, cwd=checkout)
    return checkout, git("rev-parse", "FETCH_HEAD", cwd=checkout), git("rev-parse", "FETCH_HEAD:pstack", cwd=checkout)


def archive(checkout):
    # Checkout batches lazy blob downloads; archive alone fetches them one by one.
    git("sparse-checkout", "set", "pstack", cwd=checkout)
    git("checkout", "--detach", "FETCH_HEAD", cwd=checkout)
    data = git("archive", "FETCH_HEAD", "pstack", cwd=checkout, binary=True)
    result = {}
    with tarfile.open(fileobj=io.BytesIO(data)) as package:
        for member in package:
            if member.isdir():
                continue
            path = PurePosixPath(member.name)
            if path.parts[0] != "pstack" or ".." in path.parts or not member.isfile():
                raise ValueError(f"Unsupported upstream archive entry: {member.name}")
            result[str(path.relative_to("pstack"))] = (package.extractfile(member).read(), bool(member.mode & 0o111))
    return result


def publish_update(root, source, lock):
    destination = root / "pstack/upstream"
    temporary = Path(tempfile.mkdtemp(prefix=".incoming-", dir=root / "pstack"))
    previous = temporary / "previous"
    committed = False
    try:
        staged = temporary / "upstream"
        changed = files(destination) != source
        if changed:
            write_tree(staged, source)
        staged_lock = temporary / "lock.json"
        staged_lock.write_text(json.dumps(lock, indent=2) + "\n")
        try:
            if changed:
                destination.rename(previous)
                staged.rename(destination)
            staged_lock.replace(root / "pstack/lock.json")
            committed = True
        except BaseException:
            if previous.exists():
                if destination.exists():
                    destination.rename(staged)
                previous.rename(destination)
            raise
    finally:
        # Retain the backup if rollback itself fails so originals remain recoverable.
        if committed or not previous.exists():
            shutil.rmtree(temporary)


def synchronize(root, command):
    lock = read_lock(root)
    if command == "update" and (root / "pstack/generated").is_symlink():
        raise ValueError("Refusing generated directory symlink")
    with tempfile.TemporaryDirectory(prefix="pstack-fetch-") as temporary:
        checkout, commit, tree = fetch(lock["repository"], lock["branch"], temporary)
        if command == "check":
            if tree == lock["tree"]:
                print(f"pstack: up to date ({lock['commit'][:12]})")
            else:
                print(f"pstack: upstream changed ({lock['commit'][:12]} -> {commit[:12]}). Run pstack-sync update.")
                print(f"https://github.com/cursor/plugins/compare/{lock['commit']}...{commit}")
            return
        source = archive(checkout)
        if git_tree(source) != tree:
            raise ValueError("Fetched archive does not match upstream's tree")
        version = json.loads(source["plugin.json"][0])["version"]
        if not isinstance(version, str) or not version:
            raise ValueError("Upstream plugin version must be a nonempty string")
        generated = render(root, source)
        names = skill_names(source)
        preflight_links(link_plan(root, names))
        if files(root / "pstack/upstream") != source:
            # Keep local source edits until the operator resolves them explicitly.
            if git_tree(files(root / "pstack/upstream")) != lock["tree"]:
                raise ValueError("Local edits in pstack/upstream; restore or save them before updating")
        lock.update(commit=commit, tree=tree, version=version,
                    generated_sha256=fingerprint(generated))
        publish_update(root, source, lock)
    install(root)
    print("pstack: update validated. Review the source, adapter, lock, and skill-link changes with git diff.")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", choices=("check", "update", "verify", "install"))
    parser.add_argument("--root", type=Path, default=ROOT, help=argparse.SUPPRESS)
    args = parser.parse_args()
    root = args.root.resolve()
    try:
        (root / ".cache").mkdir(exist_ok=True)
        with (root / ".cache/pstack-sync.lock").open("w") as guard:
            fcntl.flock(guard, fcntl.LOCK_EX)
            if args.command in ("check", "update"):
                synchronize(root, args.command)
            elif args.command == "install":
                install(root)
            else:
                lock, generated = verified(root)
                destination = root / "pstack/generated"
                if destination.exists() and not generated_matches(destination, generated):
                    raise ValueError("Installed generated files drifted; run pstack-sync install")
                print(f"pstack: source and adapter output verified ({lock['commit'][:12]})")
    except (OSError, ValueError, KeyError, subprocess.SubprocessError, tarfile.TarError) as error:
        parser.exit(1, f"pstack: {error}\n")


if __name__ == "__main__":
    main()
