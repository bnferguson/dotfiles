{
  "lastChangelogVersion": "1.3.0",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-sol",
  "subagents": {
    "agentOverrides": {
      "context-builder": {
        "model": ""
      },
      "planner": {
        "model": ""
      },
      "researcher": {
        "model": ""
      },
      "reviewer": {
        "model": ""
      },
      "scout": {
        "model": ""
      },
      "worker": {
        "model": ""
      }
    }
  },
  "packages": [
    "npm:pi-claude-cli",
    "npm:pi-lmstudio",
    "npm:pi-web-access",
    "npm:@tintinweb/pi-subagents",
    "npm:pi-powerline-footer",
    "npm:pi-lens",
    "npm:@nateberkopec/pi-meridian@0.1.0-beta.1",
    "git:github.com/nateberkopec/pi-openai-guidance",
    "npm:pi-intercom",
    "npm:pi-context-view"
  ],
  "skills": [
    "~/.claude/skills"
  ],
  "powerline": {
    "disabledSegments": [
      "git"
    ],
    "git": {
      "polling": "off"
    },
    "customItems": [
      {
        "id": "vcs",
        "statusKey": "vcs",
        "position": "left",
        "selfColorize": true
      },
      {
        "id": "work-links",
        "statusKey": "work-links",
        "position": "left",
        "color": "accent"
      },
      {
        "id": "indexes",
        "statusKey": "code-intel-indexes",
        "position": "left",
        "color": "accent"
      }
    ],
    "secondaryOverflow": "wrap",
    "layout": {
      "left": [
        "path",
        "custom:vcs",
        "custom:work-links"
      ],
      "right": [],
      "secondary": [
        "model",
        "thinking",
        "shell_mode",
        "context_pct",
        "cache_read",
        "cost",
        "custom:indexes",
        "queue",
        "extension_statuses"
      ]
    }
  },
  "theme": "dark",
  "defaultThinkingLevel": "medium"
}