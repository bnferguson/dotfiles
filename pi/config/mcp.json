{
  "mcpServers": {
    "linear": {
      "url": "https://mcp.linear.app/mcp"
    },
    "notion": {
      "url": "https://mcp.notion.com/mcp"
    },
    "rea": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "rea-agents@6.4.0",
        "mcp"
      ],
      "env": {
        "GHIDRA_INSTALL_DIR": "/opt/homebrew/opt/ghidra/libexec",
        "JAVA_HOME": "/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home"
      }
    },
    "terraform": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "hashicorp/terraform-mcp-server:1.3.0",
        "stdio",
        "--toolsets=registry"
      ],
      "exposure": "codemode",
      "description": "Search Terraform Registry provider and module documentation; does not run local Terraform plans or applies."
    }
  }
}
