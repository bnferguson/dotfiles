# GitButler counterparts to the git/ topic's shortcuts.
alias bst='but status'
alias bstf='but status -f'
alias bstv='but status -fv'
alias bl='but pull'
alias bp='but push'
alias bd='but diff'
# Keep bc available as the calculator.
alias bcm='but commit'
alias bb='but branch'
alias bnew='but branch new'

# Applying adds a branch to the workspace; it is not an exclusive checkout.
alias bco='but apply'
# Unapplying removes the entire stack containing the named branch.
alias bu='but unapply'
alias bundo='but undo'
alias bpr='but pr'
