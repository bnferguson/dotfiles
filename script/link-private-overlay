#!/usr/bin/env python3
"""Link a private dotfiles overlay into this repo without tracking it.

The private repo mirrors this repo's layout. Its skills and Claude agents are
linked in place, and their paths go in a generated block in the shared
.git/info/exclude, which Git never commits, so even the names stay private.
Its Claude managed settings are linked as a managed-settings.d drop-in.
"""
import argparse
import json
import os
import platform
import subprocess
import sys
from pathlib import Path

BEGIN = "# >>> dotfiles-private overlay (generated by script/link-private-overlay)"
END = "# <<< dotfiles-private overlay"
DROP_IN = "50-dotfiles-private.json"


def warn(message):
    print(f"! {message}", file=sys.stderr)


def git_common_dir(root):
    output = subprocess.run(
        ["git", "-C", str(root), "rev-parse", "--git-common-dir"],
        check=True, capture_output=True, text=True,
    ).stdout.strip()
    return (root / output).resolve()


def default_managed_dir():
    if platform.system() == "Darwin":
        return Path("/Library/Application Support/ClaudeCode/managed-settings.d")
    return Path("/etc/claude-code/managed-settings.d")


def visible(directory):
    if not directory.is_dir():
        return []
    return sorted(p for p in directory.iterdir() if not p.name.startswith("."))


def wanted_links(root, private):
    """Map each overlay path in the public repo to the target it links to."""
    links = {}
    for skill in visible(private / ".agents/skills"):
        if not (skill / "SKILL.md").is_file():
            continue
        shared = root / ".agents/skills" / skill.name
        links[shared] = skill
        # Claude reads skills through its native root, which holds a link to
        # each shared skill. Codex and pi read ~/.agents/skills directly.
        links[root / "claude/config/skills" / skill.name] = shared
    for agent in visible(private / "claude/config/agents"):
        links[root / "claude/config/agents" / agent.name] = agent
    return links


def points_to(path, target):
    return path.is_symlink() and Path(os.path.abspath(path.parent / os.readlink(path))) == target


def ensure_link(path, target):
    """Create a relative link, never replacing anything the repo owns."""
    if points_to(path, target):
        return True
    if path.exists() or path.is_symlink():
        warn(f"{path} already exists; skipping the private {target.name}")
        return False
    path.parent.mkdir(parents=True, exist_ok=True)
    path.symlink_to(os.path.relpath(target, path.parent))
    return True


def read_block(exclude):
    if not exclude.is_file():
        return [], []
    lines = exclude.read_text().splitlines()
    if BEGIN not in lines or END not in lines[lines.index(BEGIN):]:
        return lines, []
    start = lines.index(BEGIN)
    stop = lines.index(END, start)
    return lines[:start] + lines[stop + 1:], lines[start + 1:stop]


def write_block(exclude, outside, entries):
    lines = list(outside)
    while lines and not lines[-1].strip():
        lines.pop()
    if entries:
        lines += ["", BEGIN, *entries, END]
    exclude.parent.mkdir(parents=True, exist_ok=True)
    exclude.write_text("\n".join(lines) + "\n" if lines else "")


def link_overlay(root, private):
    root = root.resolve()
    exclude = git_common_dir(root) / "info/exclude"
    outside, previous = read_block(exclude)

    linked = []
    if private.is_dir():
        for path, target in wanted_links(root, private.resolve()).items():
            if ensure_link(path, target):
                linked.append(path)
    entries = ["/" + str(path.relative_to(root)) for path in linked]

    # Remove links for overlay entries that are gone. Only links that dangle
    # or lead into the overlay are removed, so a skill promoted into this repo
    # keeps its Claude link. Shared links come first in the block, so the
    # Claude link behind a removed skill dangles by the time it is checked.
    overlay = private.resolve()
    for entry in previous:
        if entry in entries:
            continue
        stale = root / entry.lstrip("/")
        if stale.is_symlink() and (
                not stale.exists() or stale.resolve().is_relative_to(overlay)):
            stale.unlink()

    write_block(exclude, outside, entries)
    return linked


def install_hook(root):
    hooks = git_common_dir(root) / "hooks"
    hook = hooks / "pre-commit"
    guard = root.resolve() / "script/check-private-leaks"
    if points_to(hook, guard):
        return
    if hook.exists() or hook.is_symlink():
        warn(f"{hook} already exists; add script/check-private-leaks to it by hand")
        return
    hooks.mkdir(parents=True, exist_ok=True)
    hook.symlink_to(os.path.relpath(guard, hooks))


def link_managed_settings(private, managed_dir, use_sudo):
    """Link the private Claude settings as a managed-settings.d drop-in.

    Claude Code reads autoMode only from user and managed settings. The user
    file is public, so a managed drop-in is the only private user-wide place.
    """
    source = private / "claude/managed-settings.json"
    drop_in = managed_dir / DROP_IN
    if not source.is_file():
        if drop_in.is_symlink() and not drop_in.exists():
            run_as_root(["rm", "-f", str(drop_in)], use_sudo)
        return
    try:
        json.loads(source.read_text())
    except ValueError as error:
        # Claude Code would reject a broken policy file, so keep the old link.
        warn(f"{source} is not valid JSON ({error}); not linking it")
        return
    if points_to(drop_in, source.resolve()):
        return
    print(f"› linking {drop_in} (needs sudo)")
    if not run_as_root(["mkdir", "-p", str(managed_dir)], use_sudo) or \
            not run_as_root(["ln", "-sfn", str(source.resolve()), str(drop_in)], use_sudo):
        warn(f"could not link {drop_in}; run: sudo mkdir -p '{managed_dir}' && "
             f"sudo ln -sfn '{source.resolve()}' '{drop_in}'")


def run_as_root(command, use_sudo):
    if not use_sudo:
        return False
    return subprocess.run(["sudo", *command]).returncode == 0


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", type=Path, default=Path(__file__).resolve().parent.parent)
    parser.add_argument("--private", type=Path, default=Path(
        os.environ.get("DOTFILES_PRIVATE", Path.home() / ".dotfiles-private")))
    parser.add_argument("--managed-dir", type=Path, default=default_managed_dir())
    parser.add_argument("--no-sudo", action="store_true",
                        help="Skip the Claude managed settings drop-in")
    args = parser.parse_args()

    install_hook(args.root)
    linked = link_overlay(args.root, args.private)
    if args.private.is_dir():
        link_managed_settings(args.private, args.managed_dir, not args.no_sudo)
        print(f"› private overlay: {len(linked)} links from {args.private}")


if __name__ == "__main__":
    main()
