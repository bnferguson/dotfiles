#!/usr/bin/env bash
#
# Run all dotfiles installers.

cd "$(dirname "$0")"/.. || exit 1
failures=0

# Run package setup in its own fail-fast subshell, then continue topics even
# if a package manager fails. The caller can inspect the aggregate exit code.
install_packages() (
set -e
# Install packages
if command -v brew >/dev/null 2>&1; then
  echo "› brew bundle"
  brew bundle --file=Brewfile
elif command -v omarchy >/dev/null 2>&1; then
  if [ "${DOTFILES_UNATTENDED:-0}" = 1 ]; then
    echo "› SKIP: Omarchy package/service setup (use dots --interactive)."
    exit 0
  fi
  echo "› installing packages via Omarchy"

  # The standalone `rust` package conflicts with `rustup`. Omarchy's drop
  # helper matches exact installed package names, so this is a safe no-op once
  # rustup owns the toolchain.
  omarchy pkg drop rust

  omarchy pkg add \
    zsh starship mise neovim jq go-yq fzf fd zellij ast-grep uv rustup jujutsu keyd openssh \
    actionlint syncthing tailscale gpu-screen-recorder \
    ttf-ibmplex-mono-nerd \
    firefox telegram-desktop signal-desktop zed

  # Default browser — only set if not already Firefox so we don't fight
  # a user override on subsequent `dots` runs.
  if command -v xdg-settings >/dev/null 2>&1 \
    && [ "$(xdg-settings get default-web-browser 2>/dev/null)" != "firefox.desktop" ]; then
    echo "› setting Firefox as default browser"
    xdg-settings set default-web-browser firefox.desktop
  fi

  # AUR packages — use Omarchy's availability check and package wrapper.
  if omarchy pkg aur accessible; then
    echo "› installing AUR packages via Omarchy"
    omarchy pkg aur add slack-desktop
  else
    echo "  Note: AUR unavailable; skipping AUR packages (slack-desktop)"
  fi

  # keyd — system-level key remapper for Hyper key (Caps Lock → Esc/Hyper)
  DOTFILES_ROOT="$(cd "$(dirname "$0")/.." && pwd -P)"
  if [ -f "$DOTFILES_ROOT/linux/keyd/default.conf" ]; then
    echo "› configuring keyd"
    sudo cp "$DOTFILES_ROOT/linux/keyd/default.conf" /etc/keyd/default.conf
    sudo systemctl enable keyd
    sudo systemctl restart keyd
  fi

  # sshd — key-only auth, no root login. Validate the merged config before
  # reloading and back out the drop-in on failure so we can't lock ourselves out.
  if [ -f "$DOTFILES_ROOT/linux/ssh/sshd-hardening.conf" ]; then
    echo "› hardening sshd"
    sudo install -m 0644 "$DOTFILES_ROOT/linux/ssh/sshd-hardening.conf" \
      /etc/ssh/sshd_config.d/10-hardening.conf
    if sudo sshd -t; then
      sudo systemctl enable --now sshd
      sudo systemctl reload sshd
    else
      echo "  sshd config test failed; removing drop-in to avoid lockout" >&2
      sudo rm -f /etc/ssh/sshd_config.d/10-hardening.conf
    fi
  fi

  # tailscale — enable the daemon; `tailscale up` is left to run manually
  # since it needs interactive auth.
  if command -v tailscaled >/dev/null 2>&1; then
    echo "› enabling tailscaled"
    sudo systemctl enable --now tailscaled
  fi
elif command -v apt-get >/dev/null 2>&1; then
  echo "› installing packages via apt"
  sudo apt-get update
  sudo apt-get install -y zsh neovim jq fzf fd-find
  # These need separate install methods on Ubuntu:
  # starship: curl -sS https://starship.rs/install.sh | sh
  # mise:     curl https://mise.run | sh
  # gh comes from mise once it is installed — see mise/config.toml.
  echo "  Note: starship and mise need manual install on Ubuntu — see README"
fi
)
install_packages
package_status=$?
echo "› END: packages (exit=$package_status)"
[ "$package_status" -eq 0 ] || failures=$((failures + 1))

# Switch default shell to whatever shell.env declares, if it isn't already.
# shell.env is the single source of truth for the shell path.
if [ "${DOTFILES_UNATTENDED:-0}" = 1 ]; then
  echo "› SKIP: default-shell setup (use script/bootstrap)."
elif [ -f shell.env ]; then
  desired_shell="$(. ./shell.env && echo "$SHELL")"
  if [ -x "$desired_shell" ]; then
    if command -v getent >/dev/null 2>&1; then
      current_shell="$(getent passwd "$USER" | cut -d: -f7)"
    elif command -v dscl >/dev/null 2>&1; then
      current_shell="$(dscl . -read "/Users/$USER" UserShell 2>/dev/null | awk '{print $2}')"
    else
      current_shell="$SHELL"
    fi
    if [ "$current_shell" != "$desired_shell" ]; then
      echo "› changing default shell to $desired_shell"
      if ! grep -qx "$desired_shell" /etc/shells; then
        echo "$desired_shell" | sudo tee -a /etc/shells >/dev/null
      fi
      chsh -s "$desired_shell"
    fi
  else
    echo "  Note: shell.env points to $desired_shell but it isn't executable; skipping chsh"
  fi
fi

# Run topic installers
# Read the installer list on fd 3 so each installer inherits the real stdin
# (the terminal). Piping find into `while read` would leave stdin as the pipe,
# and any password prompt (e.g. `sudo softwareupdate`) couldn't disable echo —
# your typed password would be visible.
case "$(uname -s)" in
  Darwin) excluded_os='./linux' ;;
  Linux) excluded_os='./macos' ;;
  *) excluded_os='./no-os-bucket' ;;
esac
while IFS= read -r installer <&3 ; do
  echo "› START: $installer"
  "$installer"
  status=$?
  echo "› END: $installer (exit=$status)"
  if [ "$status" -ne 0 ]; then
    echo "! Installer failed: $installer; continuing." >&2
    failures=$((failures + 1))
  fi
done 3< <(find . \( -name .git -o -name .cache -o -name node_modules \
  -o -path './.agents' -o -path './script' -o -path './claude/config/skills' \
  -o -path './codex/config/skills' -o -path './pi/config/skills' -o -path "$excluded_os" \) -prune \
  -o -name install.sh -type f -print | LC_ALL=C sort)
# Direct native installs are tracked immediately; consolidate portable copies
# after installers finish. This does not bootstrap global directory links.
if [ -f script/migrate-agent-directories ]; then
  echo "› START: shared skill consolidation"
  python3 script/migrate-agent-directories --root "$PWD" --skills-only
  status=$?
  echo "› END: shared skill consolidation (exit=$status)"
  if [ "$status" -ne 0 ]; then
    echo "! Shared skill consolidation failed; originals remain backed up or intact." >&2
    failures=$((failures + 1))
  fi
fi

echo "› Installer summary: failed=$failures"
[ "$failures" -eq 0 ]
