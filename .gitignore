git/gitconfig.local.symlink

# Generated / cached
.cache/
.migration-backups/
__pycache__/
.DS_Store

# Nvim (lazy.nvim installs to stdpath("data"), not in dotfiles)

# Claude Code — local project state: settings with local paths, and agent
# worktrees (real git worktrees checked out under the repo, not content to track)
.claude/

# Claude's account-synced skill catalog is generated/private, not source config.
/claude/config/skills/synced
/claude/config/skills/.trash

# Codex — local project config/state and isolated worktrees.
.codex/
# Codex refreshes its bundled system skills independently of user installs.
/codex/config/skills/.system

# code-intel — graphify installs its own skill per-machine (code-intel/install.sh);
# the router skill (code-intel/) is the committed layer.
.agents/skills/graphify/
/claude/config/skills/graphify

# pi extensions — npm deps for the lsp extension (vscode-jsonrpc), installed
# per-machine by pi/install.sh
pi/config/extensions/node_modules/
pi/config/extensions/package-lock.json

# Zig build artifacts, produced by scripts/check_files.sh
.zig-cache/
zig-out/
